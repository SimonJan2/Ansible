write-kubeconfig-mode: "0644"
token: {{ hostvars['kube-master-1']['token'] }}
server: https://{{ hostvars['kube-master-1']['ansible_host'] }}:6443
tls-san:
  - {{ vip }}
  - {{ hostvars['kube-master-1']['ansible_host'] }}
  - {{ hostvars['kube-master-2']['ansible_host'] }}
  - {{ hostvars['kube-master-3']['ansible_host'] }}
node-label:
  - server=true
disable:
  - servicelb
